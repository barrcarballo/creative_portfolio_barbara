---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FurName from '../components/FurName.astro';
import HangingStars from '../components/HangingStars.astro';
import Typewriter from '../components/Typewriter.astro';
import SectionDialog from '../components/SectionDialog.astro';
import { sections } from '../data/sections';

const roles = ['diseñadora multimedial', 'creativa', 'diseñadora UX/UI', 'fan de los detalles'];

const starLinks = sections.map(({ id, label }) => ({ label, href: `#${id}` }));
---

<BaseLayout title="Barbara — Creative portfolio">
  <SiteHeader />

  <main>
    <section class="hero" id="top" data-rope-anchor>
      <div class="hero__title" data-fur-zone>
        <h1 class="hero__heading">
          <span class="hero__greeting">
            <em>Hola!</em> <span class="hero__soy">soy</span>
          </span>
          <FurName name="Barbara" />
        </h1>
        <Typewriter class="hero__role" phrases={roles} />
      </div>

      <div class="hero__intro">
        <p>Diseño experiencias digitales con personalidad: simples, intuitivas e imposibles de confundir.</p>
        <p class="hero__cta">
          Mirá mis <a href="#work">trabajos</a>, <a href="#about">conoceme</a> o <a href="#contact">hablemos</a>.
        </p>
      </div>

      <HangingStars items={starLinks} label="Portfolio sections" />
    </section>
  </main>

  <SectionDialog sections={sections} />
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 4vw, 76px);
    min-height: 100svh;
    padding: clamp(110px, 7.3vw, 140px) var(--page-gutter) clamp(40px, 3.4vw, 64px);
    overflow-x: clip;
  }

  /* Text sits above the ropes, which hang from the top of the hero. */
  .hero__title,
  .hero__intro {
    position: relative;
    z-index: 20;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4167em;
    font-family: var(--font-display);
    font-size: clamp(26px, 7.6vw, 80px);
    line-height: normal;
  }

  .hero__heading {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.15em;
    margin: 0;
    font: inherit;
    font-weight: 400;
    white-space: nowrap;
  }

  .hero__greeting {
    padding-top: 0.354em;
  }

  .hero__greeting em {
    font-style: italic;
  }

  .hero__soy {
    font-family: var(--font-display-alt);
  }

  .hero__title :global(.hero__role) {
    margin: 0;
    font-style: italic;
    text-align: center;
  }

  .hero__intro {
    max-width: 1756px;
    font-size: clamp(16px, 0.8rem + 0.75vw, 26px);
    text-align: center;
    text-wrap: balance;
  }

  .hero__intro p {
    margin: 0;
  }

  .hero__cta {
    font-weight: 600;
  }

  .hero__cta a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s ease;
  }

  .hero__cta a:hover,
  .hero__cta a:focus-visible {
    text-decoration-color: currentColor;
  }
</style>
