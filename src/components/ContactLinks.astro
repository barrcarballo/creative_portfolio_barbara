---
/**
 * Contact buttons (Email, WhatsApp, Instagram) shown inside the Contact star.
 * They show the channel's name only — the address/number isn't displayed — and
 * each opens the right app: `mailto:` uses the visitor's mail app, the others
 * open in a new tab. Icons turn gold on hover like the rest of the site.
 */
import type { ContactLink } from '../data/sections';

interface Props {
  links: ContactLink[];
}

const { links } = Astro.props;

// 24 × 24 stroke icons, `currentColor`.
const icons: Record<ContactLink['type'], string> = {
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
  whatsapp:
    '<path d="M4 20l1.3-4A8 8 0 1 1 8.2 19z"/><path d="M9 8.6c0 3.3 3 6.4 6.4 6.4l1.1-1.5-1.8-.9-.9.8c-1.2-.5-2.4-1.7-2.9-2.9l.8-.9-.9-1.8z"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>',
};
---

<ul class="contact-links" aria-label="Contacto" data-contact-links>
  {
    links.map((link) => {
      const external = !link.href.startsWith('mailto:');
      return (
        <li>
          <a
            class="contact-links__link"
            href={link.href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <svg
              class="contact-links__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[link.type]}
            />
            <span>{link.label}</span>
            {external && <span class="visually-hidden">(se abre en una pestaña nueva)</span>}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1cqw;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-links__link {
    display: inline-flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.8cqw 1.5cqw;
    border: 1px solid rgb(74 37 0 / 0.18);
    border-radius: var(--radius-pill);
    background: rgb(74 37 0 / 0.05);
    color: var(--color-brown);
    font-family: var(--font-ui);
    font-size: max(13px, 1.5cqw);
    white-space: nowrap;
    text-decoration: none;
    transition:
      translate 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.25s ease;
  }

  .contact-links__icon {
    flex: none;
    width: max(17px, 2.1cqw);
    height: auto;
    transition:
      color 0.25s ease,
      filter 0.25s ease;
  }

  .contact-links__link:hover,
  .contact-links__link:focus-visible {
    translate: 0 -0.3cqw;
    background: rgb(255 255 255 / 0.6);
  }

  .contact-links__link:hover .contact-links__icon,
  .contact-links__link:focus-visible .contact-links__icon {
    color: #e8a33a;
    filter: drop-shadow(0 0 0.5cqw rgb(255 196 92 / 0.9));
  }

  .contact-links__link:focus-visible {
    outline: 2px solid var(--color-brown);
    outline-offset: 3px;
  }

  @media (max-width: 719px) {
    .contact-links {
      gap: 1.5cqw;
    }

    .contact-links__link {
      gap: 1cqw;
      padding: 1.2cqw 2cqw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-links__link,
    .contact-links__icon {
      transition: none;
    }

    .contact-links__link:hover,
    .contact-links__link:focus-visible {
      translate: none;
    }
  }
</style>
