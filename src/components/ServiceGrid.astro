---
/**
 * Services shown inside the "Services" star: a 2 × 2 grid of cards with a line
 * icon, a title and a short description. Icons are inline SVGs using
 * `currentColor`, so hover can tint them gold. Sizes use `cqw` of the
 * surrounding big star. On narrow screens the description is kept for screen
 * readers only, so the grid still fits inside the star.
 */
import type { Service, ServiceIcon } from '../data/sections';

interface Props {
  services: Service[];
}

const { services } = Astro.props;

// 24 × 24 line icons, stroke-only.
const icons: Record<ServiceIcon, string> = {
  // Monitor + phone
  devices:
    '<rect x="2" y="4" width="15" height="11" rx="1.5"/><path d="M7 19h5M9.5 15v4"/><rect x="15.5" y="9" width="6.5" height="11" rx="1.3"/><path d="M18.2 17.5h1.1"/>',
  // Pen nib
  pen: '<path d="M12 3l6 6-7.5 10.5L4 21l1.5-6.5L12 3z"/><path d="M4 21l5.2-5.2"/><circle cx="10.5" cy="13.5" r="1.6"/><path d="M14 5l5 5"/>',
  // Clapperboard
  video:
    '<rect x="3" y="9" width="18" height="12" rx="1.5"/><path d="M3 9l1-4.5 17-.5-1 5"/><path d="M8 4.5L9.5 9M13 4.3l1.5 4.7M10 13.5v4l4-2-4-2z"/>',
  // Code brackets
  code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 4.5l-3 15"/>',
};
---

<ul class="services" aria-label="Servicios" data-services>
  {
    services.map((service) => (
      <li class="services__card">
        <svg
          class="services__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons[service.icon]}
        />
        <h3 class="services__title">{service.title}</h3>
        <p class="services__description">{service.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4cqw;
    width: 44cqw;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .services__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5cqw;
    padding: 1.4cqw 1.2cqw 1.5cqw;
    border: 1px solid rgb(74 37 0 / 0.14);
    border-radius: 2cqw;
    background: rgb(74 37 0 / 0.05);
    text-align: center;
    transition:
      translate 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .services__icon {
    width: max(22px, 3.2cqw);
    height: auto;
    color: var(--color-brown);
    transition:
      color 0.25s ease,
      filter 0.25s ease,
      rotate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .services__title {
    margin: 0;
    color: var(--color-brown);
    font-family: var(--font-ui);
    font-size: max(13px, 1.55cqw);
    font-weight: 400;
    line-height: 1.15;
  }

  .services__description {
    margin: 0;
    color: #1d1006;
    font-family: var(--font-body);
    font-size: max(11px, 1.12cqw);
    line-height: 1.35;
  }

  /* Hover: lift the card and light the icon up with the site's gold glow. */
  .services__card:hover {
    translate: 0 -0.5cqw;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 0.8cqw 2cqw rgb(74 37 0 / 0.12);
  }

  .services__card:hover .services__icon {
    color: #e8a33a;
    filter: drop-shadow(0 0 0.6cqw rgb(255 196 92 / 0.9));
    rotate: -8deg;
  }

  /* Narrow screens: keep the grid inside the star; descriptions stay for screen readers. */
  @media (max-width: 719px) {
    .services {
      width: 50cqw;
      gap: 1.8cqw;
    }

    .services__card {
      padding: 2cqw 1.4cqw;
    }

    .services__description {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services__card,
    .services__icon {
      transition: none;
    }

    .services__card:hover {
      translate: none;
    }

    .services__card:hover .services__icon {
      rotate: none;
    }
  }
</style>
