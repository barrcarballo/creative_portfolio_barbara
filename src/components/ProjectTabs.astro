---
/**
 * Project browser shown inside the "Works" star: project names as tabs, and
 * the selected project's roles and description below.
 *
 * - WAI-ARIA tabs pattern: arrow keys / Home / End move between projects.
 * - Long descriptions scroll inside their box; a fade hints there is more
 *   text and disappears once the reader reaches the end.
 * Sizes use `cqw` so everything scales with the surrounding star.
 */
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="projects" data-projects>
  <div class="projects__tabs" role="tablist" aria-label="Proyectos">
    {
      projects.map((project, index) => (
        <button
          class="projects__tab"
          type="button"
          role="tab"
          id={`project-tab-${project.id}`}
          aria-controls={`project-panel-${project.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-project-tab
        >
          {project.name}
        </button>
      ))
    }
  </div>

  {
    projects.map((project, index) => (
      <div
        class="projects__panel"
        role="tabpanel"
        id={`project-panel-${project.id}`}
        aria-labelledby={`project-tab-${project.id}`}
        hidden={index !== 0}
        data-project-panel
      >
        <h3 class="projects__name">{project.name}</h3>
        <ul class="projects__roles" aria-label="Qué hice">
          {project.roles.map((role) => (
            <li class="projects__role">{role}</li>
          ))}
        </ul>
        <p class="projects__description" tabindex="0" data-project-description>
          {project.description}
        </p>
      </div>
    ))
  }
</div>

<script>
  function initProjects(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-project-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-project-panel]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const updateFade = (description: HTMLElement) => {
      const scrollable = description.scrollHeight > description.clientHeight + 1;
      const atEnd =
        description.scrollTop + description.clientHeight >= description.scrollHeight - 2;
      description.classList.toggle('has-more', scrollable && !atEnd);
    };

    const select = (index: number, focus = false) => {
      const currentIndex = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      if (index === currentIndex) return;

      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel, i) => (panel.hidden = i !== index));

      const panel = panels[index];
      const description = panel.querySelector<HTMLElement>('[data-project-description]');
      if (description) {
        description.scrollTop = 0;
        updateFade(description);
      }
      if (!reducedMotion.matches) {
        panel.animate(
          { opacity: [0, 1], translate: ['0 6px', '0 0'] },
          { duration: 260, easing: 'ease-out' },
        );
      }
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowRight: (index + 1) % tabs.length,
          ArrowLeft: (index - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in keys) {
          event.preventDefault();
          select(keys[event.key], true);
        }
      });
    });

    root.querySelectorAll<HTMLElement>('[data-project-description]').forEach((description) => {
      description.addEventListener('scroll', () => updateFade(description), { passive: true });
      // Sizes are only known once the section is visible (the dialog starts closed).
      new ResizeObserver(() => updateFade(description)).observe(description);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-projects]').forEach(initProjects);
</script>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.2cqw;
    width: 100%;
  }

  .projects__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8cqw;
  }

  .projects__tab {
    padding: 0.5em 1.1em;
    border: 1px solid var(--color-brown);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-brown);
    font-family: var(--font-ui);
    font-size: max(12px, 1.45cqw);
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .projects__tab:hover {
    background: rgb(74 37 0 / 0.08);
  }

  .projects__tab[aria-selected='true'] {
    background: var(--color-brown);
    color: var(--color-cream);
  }

  .projects__tab:focus-visible {
    outline: 2px solid var(--color-brown);
    outline-offset: 2px;
  }

  .projects__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1cqw;
    width: 100%;
  }

  /* `display: flex` would otherwise override the `hidden` attribute. */
  .projects__panel[hidden] {
    display: none;
  }

  .projects__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: max(18px, 2.6cqw);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  .projects__roles {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5cqw;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects__role {
    padding: 0.3em 0.8em;
    border-radius: var(--radius-pill);
    background: rgb(232 126 1 / 0.14);
    color: #b35f00;
    font-family: var(--font-body);
    font-size: max(11px, 1.2cqw);
    font-weight: 600;
    line-height: 1.2;
  }

  .projects__description {
    max-height: 12cqw;
    margin: 0.4cqw 0 0;
    padding-inline: 0.6cqw;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: #000;
    font-family: var(--font-body);
    font-size: max(13px, 1.7cqw);
    line-height: 1.4;
    scrollbar-width: thin;
    scrollbar-color: rgb(74 37 0 / 0.35) transparent;
  }

  .projects__description:focus-visible {
    outline: 2px solid var(--color-brown);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Fade the bottom edge while there is more text to scroll. */
  .projects__description.has-more {
    mask-image: linear-gradient(#000 calc(100% - 2.5em), transparent);
  }

  /* Narrow screens: one scrollable row of tabs to save vertical space. */
  @media (max-width: 719px) {
    .projects__tabs {
      flex-wrap: nowrap;
      justify-content: flex-start;
      max-width: 100%;
      padding-bottom: 4px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .projects__description {
      max-height: 12.5cqw;
    }

    /* Soften the edges of the horizontally scrolling tab row. */
    .projects__tabs {
      mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
      padding-inline: 6%;
    }
  }
</style>
