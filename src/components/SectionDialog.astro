---
/**
 * Full-screen section viewer. Opening a section flies the matching hanging
 * star to the centre of the screen with a spin (FLIP animation), where it
 * becomes a large star whose cream centre opens to reveal the content.
 *
 * Two levels:
 * - Section (`#about`, `#work`…): the big star. "Siguiente" spins it a full
 *   turn while swapping content; "Volver" / Escape fly it back to its rope.
 * - Project (`#work/<project>`): from the Works constellation, the small
 *   project star spins and grows into a gallery next to a text card.
 *   "Siguiente" moves to the next project; "Volver" returns to the constellation.
 *
 * Routing: the URL hash is the single source of truth. Every in-page link to
 * a known route updates it and `route()` animates to the new state, so
 * browser Back/Forward and deep links work.
 * Built on <dialog>: focus is trapped, the page behind is inert and focus
 * returns to the opener on close.
 */
import type { Section } from '../data/sections';
import ProjectConstellation from './ProjectConstellation.astro';
import ProjectDetail from './ProjectDetail.astro';

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const projectSection = sections.find((section) => section.projects);
const splitInitial = (text: string) => [text.charAt(0), text.slice(1)];
---

<dialog class="section-dialog" aria-labelledby={`section-title-${sections[0]?.id}`} data-section-dialog>
  <div class="section-dialog__backdrop" data-section-backdrop></div>

  <button class="section-dialog__btn section-dialog__btn--back" type="button" data-section-close>
    <img src="/images/arrow-left.svg" width="21" height="21" alt="" />
    <span><span class="script-initial">V</span>olver</span>
  </button>

  <button class="section-dialog__btn section-dialog__btn--next" type="button" data-section-next>
    <span><span class="script-initial">S</span>iguiente</span>
    <img src="/images/arrow-right.svg" width="21" height="21" alt="" />
  </button>

  <div class="section-star" data-section-star>
    <!-- Rotating layer: everything shaped like the star spins together. -->
    <div class="section-star__body" data-section-star-body>
      <img class="section-star__frame" src="/images/section-star-frame.png" alt="" loading="lazy" />
      <img
        class="section-star__leopard"
        src="/images/star-leopard.png"
        alt=""
        data-section-star-leopard
      />
      <img
        class="section-star__fill"
        src="/images/section-star-fill.svg"
        width="1056"
        height="965"
        alt=""
        loading="lazy"
        data-section-star-fill
      />
    </div>

    <!-- Content stays upright: it is not part of the rotating layer. -->
    <div class="section-star__content" data-section-content-wrap>
      {
        sections.map((section) => {
          const [initial, rest] = splitInitial(section.title);
          return (
            <article class="section-star__article" data-section-content={section.id} hidden>
              <h2 class="section-star__title" id={`section-title-${section.id}`}>
                <span class="script-initial">{initial}</span>
                {rest}
                {section.accent && <span class="section-star__accent">{section.accent}</span>}
              </h2>
              {section.projects ? (
                <ProjectConstellation sectionId={section.id} projects={section.projects} />
              ) : (
                <p class="section-star__text" set:html={section.body} />
              )}
            </article>
          );
        })
      }
    </div>
  </div>

  {projectSection?.projects && <ProjectDetail projects={projectSection.projects} />}
</dialog>

<script>
  const FLIGHT_MS = 950;
  const OPEN_FILL_MS = 420;
  const NEXT_MS = 850;
  const FLIGHT_EASING = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const SWAP_EASING = 'cubic-bezier(0.65, 0, 0.35, 1)';

  const dialog = document.querySelector<HTMLDialogElement>('[data-section-dialog]');

  if (dialog) initSectionDialog(dialog);

  function initSectionDialog(dialog: HTMLDialogElement) {
    const star = dialog.querySelector<HTMLElement>('[data-section-star]')!;
    const body = dialog.querySelector<HTMLElement>('[data-section-star-body]')!;
    const leopard = dialog.querySelector<HTMLElement>('[data-section-star-leopard]')!;
    const fill = dialog.querySelector<HTMLElement>('[data-section-star-fill]')!;
    const contentWrap = dialog.querySelector<HTMLElement>('[data-section-content-wrap]')!;
    const backdrop = dialog.querySelector<HTMLElement>('[data-section-backdrop]')!;
    const buttons = [...dialog.querySelectorAll<HTMLElement>('.section-dialog__btn')];
    const articles = new Map(
      [...dialog.querySelectorAll<HTMLElement>('[data-section-content]')].map((el) => [
        el.dataset.sectionContent!,
        el,
      ]),
    );
    const ids = [...articles.keys()];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Project level (Works).
    const detail = dialog.querySelector<HTMLElement>('[data-project-detail]');
    const projectPanels = new Map(
      [...dialog.querySelectorAll<HTMLElement>('[data-project-panel]')].map((el) => [
        el.dataset.projectPanel!,
        el,
      ]),
    );
    const projectIds = [...projectPanels.keys()];
    const projectSectionId =
      dialog.querySelector('[data-project-mini]')?.closest<HTMLElement>('[data-section-content]')
        ?.dataset.sectionContent ?? null;

    let current: string | null = null;
    let project: string | null = null;
    let busy = false;

    const motion = () => !reducedMotion.matches;

    const slotFor = (id: string) =>
      document.querySelector<HTMLElement>(`[data-star-slot][data-section="${id}"]`);

    const miniFor = (id: string) =>
      dialog.querySelector<HTMLElement>(`[data-project-mini="${id}"]`);

    const partsOf = (id: string) => {
      const panel = projectPanels.get(id)!;
      return {
        panel,
        art: panel.querySelector<HTMLElement>('[data-project-art]')!,
        spin: panel.querySelector<HTMLElement>('[data-project-art-spin]')!,
        card: panel.querySelector<HTMLElement>('[data-project-card]')!,
        heading: panel.querySelector<HTMLElement>('h2'),
      };
    };

    const showArticle = (id: string) => {
      articles.forEach((el, key) => (el.hidden = key !== id));
      dialog.setAttribute('aria-labelledby', `section-title-${id}`);
    };

    const showProjectPanel = (id: string) => {
      if (detail) detail.hidden = false;
      projectPanels.forEach((el, key) => (el.hidden = key !== id));
      dialog.setAttribute('aria-labelledby', `project-name-${id}`);
    };

    /** Transform that places `target` exactly over `source` (FLIP "invert" step). */
    const flipBetween = (source: Element | null | undefined, target: Element) => {
      const to = target.getBoundingClientRect();
      const from = source?.getBoundingClientRect();
      if (!from || from.width === 0) return 'translate(0, 0) scale(0.25)';
      const dx = from.left + from.width / 2 - (to.left + to.width / 2);
      const dy = from.top + from.height / 2 - (to.top + to.height / 2);
      return `translate(${dx}px, ${dy}px) scale(${from.width / to.width})`;
    };

    const fade = (el: Element, from: number, to: number, duration: number, delay = 0) =>
      el.animate({ opacity: [from, to] }, { duration, delay, easing: 'ease', fill: 'both' }).finished;

    const cancelAnimations = (...elements: Element[]) =>
      elements.forEach((el) => el.getAnimations().forEach((animation) => animation.cancel()));

    const lockScroll = (locked: boolean) => {
      document.documentElement.style.overflow = locked ? 'hidden' : '';
    };

    // --- Section level ---------------------------------------------------

    async function open(id: string) {
      if (busy || current) return;
      busy = true;
      current = id;

      showArticle(id);
      lockScroll(true);
      dialog.showModal();

      const slot = slotFor(id);
      const from = flipBetween(slot?.querySelector('.stars__star'), star);
      slot?.classList.add('is-away');

      // Reset the layers to their "closed" look before animating in.
      [fill, contentWrap].forEach((el) => (el.style.opacity = '0'));

      fade(backdrop, 0, 1, motion() ? 400 : 200);
      buttons.forEach((btn) => fade(btn, 0, 1, 300, motion() ? FLIGHT_MS * 0.6 : 0));

      if (motion()) {
        // Fly + grow from the hanging star while spinning one full turn.
        await Promise.all([
          star.animate({ transform: [from, 'none'] }, { duration: FLIGHT_MS, easing: FLIGHT_EASING })
            .finished,
          body.animate({ rotate: ['-360deg', '0deg'] }, { duration: FLIGHT_MS, easing: FLIGHT_EASING })
            .finished,
          leopard.animate({ opacity: [1, 1, 0] }, { duration: FLIGHT_MS, fill: 'both' }).finished,
        ]);
        // The cream centre "opens" from the middle, then the content appears.
        fill.style.opacity = '';
        await fill.animate(
          { scale: [0.2, 1], opacity: [0, 1] },
          { duration: OPEN_FILL_MS, easing: 'cubic-bezier(0.34, 1.4, 0.64, 1)' },
        ).finished;
      } else {
        leopard.style.opacity = '0';
        fill.style.opacity = '';
      }

      contentWrap.style.opacity = '';
      await contentWrap.animate(
        { opacity: [0, 1], translate: motion() ? ['0 12px', '0 0'] : ['0 0', '0 0'] },
        { duration: 300, easing: 'ease-out' },
      ).finished;

      busy = false;
    }

    async function goTo(id: string) {
      if (busy || !current || id === current) return;
      busy = true;

      slotFor(current)?.classList.remove('is-away');
      slotFor(id)?.classList.add('is-away');

      await fade(contentWrap, 1, 0, 150);
      showArticle(id);
      current = id;

      if (motion()) {
        // A full turn: the star isn't perfectly symmetric, so it has to land
        // exactly where it started.
        await body.animate(
          { rotate: ['0deg', '360deg'], scale: [1, 0.92, 1] },
          { duration: NEXT_MS, easing: SWAP_EASING },
        ).finished;
      }

      await fade(contentWrap, 0, 1, 250);
      contentWrap.style.opacity = '';
      busy = false;
    }

    async function close() {
      if (busy || !current) return;
      busy = true;
      if (project) resetProjectLayer();

      const slot = slotFor(current);

      buttons.forEach((btn) => fade(btn, 1, 0, 150));
      await fade(contentWrap, 1, 0, 150);

      if (motion()) {
        await fill.animate(
          { scale: [1, 0.2], opacity: [1, 0] },
          { duration: 260, easing: 'ease-in', fill: 'forwards' },
        ).finished;
        const to = flipBetween(slot?.querySelector('.stars__star'), star);
        await Promise.all([
          star.animate(
            { transform: ['none', to] },
            { duration: FLIGHT_MS * 0.85, easing: FLIGHT_EASING, fill: 'forwards' },
          ).finished,
          body.animate(
            { rotate: ['0deg', '360deg'] },
            { duration: FLIGHT_MS * 0.85, easing: FLIGHT_EASING, fill: 'forwards' },
          ).finished,
          leopard.animate({ opacity: [0, 1] }, { duration: FLIGHT_MS * 0.4, fill: 'both' }).finished,
          fade(backdrop, 1, 0, FLIGHT_MS * 0.8, FLIGHT_MS * 0.2),
        ]);
      } else {
        await fade(backdrop, 1, 0, 200);
      }

      slot?.classList.remove('is-away');
      dialog.close();
      lockScroll(false);

      // Drop every lingering animation so the next open starts clean.
      cancelAnimations(star, body, leopard, fill, contentWrap, backdrop, ...buttons);
      [star, body, leopard, fill, contentWrap].forEach((el) => el.style.removeProperty('opacity'));

      current = null;
      busy = false;
    }

    // --- Project level ---------------------------------------------------

    /** Instantly hide the project view (used when leaving the dialog directly). */
    function resetProjectLayer() {
      projectPanels.forEach((_, id) => {
        const { art, spin, card } = partsOf(id);
        cancelAnimations(art, spin, card);
        card.style.removeProperty('opacity');
        miniFor(id)?.classList.remove('is-away');
      });
      cancelAnimations(star);
      star.inert = false;
      if (detail) detail.hidden = true;
      project = null;
    }

    async function openProject(id: string) {
      if (busy || !current || current !== projectSectionId || project) return;
      busy = true;
      project = id;

      const { art, spin, card, heading } = partsOf(id);
      const mini = miniFor(id);
      showProjectPanel(id);
      const from = flipBetween(mini?.querySelector('[data-star-art]'), art);
      mini?.classList.add('is-away');
      star.inert = true;
      card.style.opacity = '0';

      if (motion()) {
        // The small star spins and grows into the gallery while the big star recedes.
        await Promise.all([
          star.animate(
            { opacity: [1, 0], scale: [1, 0.9] },
            { duration: 450, easing: 'ease', fill: 'forwards' },
          ).finished,
          art.animate({ transform: [from, 'none'] }, { duration: FLIGHT_MS, easing: FLIGHT_EASING })
            .finished,
          spin.animate({ rotate: ['-360deg', '0deg'] }, { duration: FLIGHT_MS, easing: FLIGHT_EASING })
            .finished,
        ]);
      } else {
        await star.animate({ opacity: [1, 0] }, { duration: 200, fill: 'forwards' }).finished;
      }

      card.style.opacity = '';
      await card.animate(
        { opacity: [0, 1], translate: motion() ? ['16px 0', '0 0'] : ['0 0', '0 0'] },
        { duration: 300, easing: 'ease-out' },
      ).finished;

      heading?.focus({ preventScroll: true });
      busy = false;
    }

    async function goToProject(id: string) {
      if (busy || !project || id === project) return;
      busy = true;

      const previous = partsOf(project);
      const next = partsOf(id);
      miniFor(project)?.classList.remove('is-away');
      miniFor(id)?.classList.add('is-away');

      await fade(previous.card, 1, 0, 150);
      // Half a turn out with the old project, half a turn in with the new one.
      if (motion()) {
        await previous.spin.animate(
          { rotate: ['0deg', '180deg'], opacity: [1, 0], scale: [1, 0.9] },
          { duration: NEXT_MS / 2, easing: 'ease-in', fill: 'forwards' },
        ).finished;
      }

      showProjectPanel(id);
      cancelAnimations(previous.spin, previous.card);
      project = id;
      next.card.style.opacity = '0';

      if (motion()) {
        await next.spin.animate(
          { rotate: ['180deg', '360deg'], opacity: [0, 1], scale: [0.9, 1] },
          { duration: NEXT_MS / 2, easing: 'ease-out' },
        ).finished;
      }

      next.card.style.opacity = '';
      await next.card.animate(
        { opacity: [0, 1], translate: motion() ? ['16px 0', '0 0'] : ['0 0', '0 0'] },
        { duration: 300, easing: 'ease-out' },
      ).finished;

      next.heading?.focus({ preventScroll: true });
      busy = false;
    }

    async function closeProject() {
      if (busy || !project) return;
      busy = true;

      const { art, spin, card } = partsOf(project);
      const mini = miniFor(project);

      await fade(card, 1, 0, 150);

      if (motion()) {
        const to = flipBetween(mini?.querySelector('[data-star-art]'), art);
        await Promise.all([
          art.animate(
            { transform: ['none', to] },
            { duration: FLIGHT_MS * 0.8, easing: FLIGHT_EASING, fill: 'forwards' },
          ).finished,
          spin.animate(
            { rotate: ['0deg', '360deg'] },
            { duration: FLIGHT_MS * 0.8, easing: FLIGHT_EASING, fill: 'forwards' },
          ).finished,
          star.animate(
            { opacity: [0, 1], scale: [0.9, 1] },
            { duration: 450, delay: FLIGHT_MS * 0.3, easing: 'ease', fill: 'forwards' },
          ).finished,
        ]);
      } else {
        await star.animate({ opacity: [0, 1] }, { duration: 200, fill: 'forwards' }).finished;
      }

      resetProjectLayer();
      if (current) dialog.setAttribute('aria-labelledby', `section-title-${current}`);
      mini?.focus({ preventScroll: true });
      busy = false;
    }

    // --- Routing ---------------------------------------------------------

    /** Reads `#section` or `#section/project`; unknown parts become null. */
    const parse = (hash: string) => {
      const [sectionPart = '', projectPart = ''] = decodeURIComponent(hash.replace(/^#/, '')).split('/');
      const section = articles.has(sectionPart) ? sectionPart : null;
      const projectId =
        section && section === projectSectionId && projectPanels.has(projectPart) ? projectPart : null;
      return { section, project: projectId };
    };

    let routing = false;
    let pending = false;

    /** Animate from the current state to whatever the URL hash describes. */
    async function route() {
      if (routing) {
        pending = true;
        return;
      }
      routing = true;
      do {
        pending = false;
        const target = parse(location.hash);

        if (!target.section) {
          if (current) await close();
        } else if (!current) {
          await open(target.section);
          if (target.project) await openProject(target.project);
        } else if (target.section !== current) {
          if (project) await closeProject();
          await goTo(target.section);
          if (target.project) await openProject(target.project);
        } else if (target.project && target.project !== project) {
          await (project ? goToProject(target.project) : openProject(target.project));
        } else if (!target.project && project) {
          await closeProject();
        }
      } while (pending);
      routing = false;
    }

    /** Going deeper adds a history entry (so Back returns); everything else replaces. */
    const navigate = (hash: string | null) => {
      const depth = (h: string | null) => {
        if (!h) return 0;
        const target = parse(h);
        return target.project ? 2 : target.section ? 1 : 0;
      };
      const currentDepth = project ? 2 : current ? 1 : 0;
      const url = hash ?? location.pathname + location.search;
      if (depth(hash) > currentDepth) history.pushState(null, '', url);
      else history.replaceState(null, '', url);
      void route();
    };

    // Any in-page link to a known route opens it instead of jumping.
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!link || !parse(link.hash).section) return;
      event.preventDefault();
      navigate(link.hash);
    });

    window.addEventListener('popstate', () => void route());

    const goBack = () => navigate(project && current ? `#${current}` : null);

    dialog.querySelector('[data-section-close]')!.addEventListener('click', goBack);

    dialog.querySelector('[data-section-next]')!.addEventListener('click', () => {
      if (!current) return;
      if (project) {
        const next = projectIds[(projectIds.indexOf(project) + 1) % projectIds.length];
        navigate(`#${current}/${next}`);
      } else {
        navigate(`#${ids[(ids.indexOf(current) + 1) % ids.length]}`);
      }
    });

    // Escape: same as "Volver", animated instead of the instant native close.
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      goBack();
    });

    // Deep link (e.g. /#about or /#work/loopies) once the page has loaded.
    if (parse(location.hash).section) void route();

    // Warm the cache for the heavy star artwork without delaying first paint.
    const preload = () =>
      ['/images/section-star-fill.svg', '/images/section-star-frame.png'].forEach((src) => {
        new Image().src = src;
      });
    if ('requestIdleCallback' in window) requestIdleCallback(preload, { timeout: 4000 });
    else setTimeout(preload, 2000);
  }
</script>

<style>
  .section-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    color: var(--color-brown);
  }

  /* Own backdrop element so it can be animated together with the star. */
  .section-dialog::backdrop {
    background: transparent;
  }

  .section-dialog__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(35 18 1 / 0.9);
  }

  .section-dialog__btn {
    position: absolute;
    top: clamp(16px, 2.9vw, 56px);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 156px;
    height: 40px;
    padding: 0 24px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-cream);
    color: var(--color-brown);
    font-family: var(--font-ui);
    font-size: 18px;
    cursor: pointer;
    transition: translate 0.2s ease;
  }

  .section-dialog__btn img {
    flex: none;
    transition: translate 0.2s ease;
  }

  .section-dialog__btn--back {
    left: clamp(16px, 4.2vw, 80px);
  }

  .section-dialog__btn--next {
    right: clamp(16px, 4.2vw, 80px);
  }

  .section-dialog__btn--back:hover img {
    translate: -3px 0;
  }

  .section-dialog__btn--next:hover img {
    translate: 3px 0;
  }

  .section-dialog__btn:focus-visible {
    outline-color: var(--color-cream);
  }

  .script-initial {
    font-family: var(--font-script);
    font-style: normal;
  }

  /* --- The big star ------------------------------------------------------ */

  .section-star {
    /* Design: 1176 × 1074 inside a 1920 × 1080 frame. */
    --star-w: min(1176px, 94vw, calc(96dvh * 1176 / 1074));
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--star-w);
    aspect-ratio: 1176 / 1074;
    translate: -50% -50%;
    container-type: inline-size;
    transform-origin: center;
  }

  .section-star__body {
    position: absolute;
    inset: 0;
  }

  .section-star__frame,
  .section-star__leopard {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-star__leopard {
    opacity: 0;
  }

  .section-star__fill {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 89.9%;
    height: 89.9%;
    translate: -50% -50%;
  }

  .section-star__content {
    position: absolute;
    top: 33.4%;
    left: 49%;
    width: 46%;
    translate: -50% 0;
    text-align: center;
  }

  .section-star__article {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6cqw;
  }

  /* Sections with a project browser need the vertical space. */
  .section-star__article:has([data-project-mini]) {
    gap: 2.6cqw;
  }

  /* `display: flex` above would otherwise override the `hidden` attribute. */
  .section-star__article[hidden] {
    display: none;
  }

  .section-star__title {
    margin: 0;
    max-width: 33cqw;
    font-family: var(--font-display);
    font-size: 4.08cqw;
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  .section-star__accent {
    display: block;
    color: #e87e01;
  }

  .section-star__text {
    margin: 0;
    color: #000;
    font-family: var(--font-body);
    font-size: max(14px, 2.04cqw);
    line-height: 1.35;
  }

  /* On narrow screens the star overflows sideways so its centre stays readable. */
  @media (max-width: 719px) {
    .section-star {
      --star-w: min(150vw, calc(88dvh * 1176 / 1074));
    }

    .section-star__content {
      top: 31%;
      width: 50%;
    }

    .section-dialog__btn {
      min-width: 0;
      height: 36px;
      padding: 0 16px;
      font-size: 16px;
    }
  }
</style>
