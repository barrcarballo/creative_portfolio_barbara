---
/**
 * Project view layer inside SectionDialog. One panel per project: a large
 * star-shaped gallery on one side and a cream card with the project's name,
 * roles and description on the other (stacked on small screens).
 * SectionDialog decides which panel is visible and animates the transition;
 * this component only handles the gallery thumbnails.
 */
import { Image } from 'astro:assets';
import StarArt from './StarArt.astro';
import type { Project } from '../data/projects';
import { getProjectCardImages, getProjectImages } from '../lib/projectImages';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const splitInitial = (text: string) => [text.charAt(0), text.slice(1)];
---

<div class="project-detail" data-project-detail hidden>
  {
    projects.map((project) => {
      const images = getProjectImages(project.id);
      const cardImages = getProjectCardImages(project.id);
      const [initial, rest] = splitInitial(project.name);
      return (
        <section
          class="project"
          aria-labelledby={`project-name-${project.id}`}
          data-project-panel={project.id}
          hidden
        >
          <div class="project__media">
            <div class="project__art" data-project-art>
              <div class="project__art-spin" data-project-art-spin>
                <StarArt
                  class="project__star"
                  images={images}
                  alts={project.imageAlts}
                  name={project.name}
                  sizes="(max-width: 719px) 80vw, 45vw"
                />
              </div>
            </div>

            {images.length > 1 && (
              <div class="project__thumbs" role="group" aria-label="Imágenes del proyecto">
                {images.map((_, index) => (
                  <button
                    class="project__thumb"
                    type="button"
                    aria-label={`Ver imagen ${index + 1} de ${images.length}`}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    data-project-thumb={index}
                  />
                ))}
              </div>
            )}
          </div>

          <div class="project__card" data-project-card>
            <h2 class="project__name" id={`project-name-${project.id}`} tabindex="-1">
              <span class="project__initial">{initial}</span>
              {rest}
            </h2>
            <ul class="project__roles" aria-label="Qué hice">
              {project.roles.map((role) => (
                <li class="project__role">{role}</li>
              ))}
            </ul>
            <p class="project__description">{project.description}</p>
            {cardImages.map((image, index) => {
              // Full-page captures: show the top in the card, scroll them in the viewer.
              const tall = image.height / image.width > 1.3;
              return (
              <button
                class:list={['project__zoom', { 'project__zoom--tall': tall }]}
                type="button"
                aria-label={tall ? 'Ver página completa' : 'Ampliar imagen'}
                data-zoom
                data-tall={tall ? 'true' : undefined}
              >
                <Image
                  class="project__card-image"
                  src={image}
                  alt={project.cardImageAlts?.[index] ?? `${project.name} — pantallas del proyecto`}
                  widths={[560, 1120, 1680, 2400]}
                  sizes="(max-width: 899px) 90vw, 560px"
                  loading="lazy"
                />
                <span class="project__zoom-hint" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M20 20l-3.5-3.5M11 8v6M8 11h6" />
                  </svg>
                </span>
                {tall && <span class="project__zoom-label" aria-hidden="true">Ver página completa</span>}
              </button>
              );
            })}

            {(project.links?.caseStudy || project.links?.prototype) && (
              <div class="project__links">
                {project.links.caseStudy && (
                  <a class="project__link" href={project.links.caseStudy} target="_blank" rel="noopener noreferrer">
                    Ver desarrollo completo
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
                    <span class="visually-hidden">(se abre en una pestaña nueva)</span>
                  </a>
                )}
                {project.links.prototype && (
                  <a
                    class="project__link project__link--outline"
                    href={project.links.prototype}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Ver prototipo
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
                    <span class="visually-hidden">(se abre en una pestaña nueva)</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  <!-- Full-screen viewer for card images. A nested modal so Escape closes it first. -->
  <dialog class="lightbox" aria-label="Imagen ampliada" data-lightbox>
    <button class="lightbox__close" type="button" aria-label="Cerrar imagen" data-lightbox-close>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <img class="lightbox__image" alt="" data-lightbox-image />
  </dialog>
</div>

<script>
  // Gallery: thumbnails swap which image of the star is visible.
  document.querySelectorAll<HTMLElement>('[data-project-panel]').forEach((panel) => {
    const images = [...panel.querySelectorAll<HTMLElement>('[data-star-art-image]')];
    const thumbs = [...panel.querySelectorAll<HTMLButtonElement>('[data-project-thumb]')];

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => {
        images.forEach((image, i) => image.classList.toggle('is-active', i === index));
        thumbs.forEach((t, i) => t.setAttribute('aria-pressed', String(i === index)));
      });
    });
  });

  // Lightbox: reuses the clicked image's responsive sources at full-screen size.
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');

  if (lightbox && lightboxImage) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const close = async () => {
      if (!lightbox.open) return;
      if (!reducedMotion.matches) {
        await lightbox.animate({ opacity: [1, 0] }, { duration: 180, easing: 'ease-in' }).finished;
      }
      lightbox.close();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) => {
      button.addEventListener('click', () => {
        const source = button.querySelector('img');
        if (!source) return;
        lightboxImage.srcset = source.srcset;
        lightboxImage.sizes = '95vw';
        lightboxImage.src = source.currentSrc || source.src;
        lightbox.classList.toggle('is-tall', button.dataset.tall === 'true');
        lightbox.scrollTop = 0;
        lightboxImage.alt = source.alt;
        lightbox.showModal();
        if (!reducedMotion.matches) {
          lightbox.animate({ opacity: [0, 1] }, { duration: 220, easing: 'ease-out' });
          lightboxImage.animate(
            { scale: [0.92, 1], opacity: [0, 1] },
            { duration: 320, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          );
        }
      });
    });

    lightbox.querySelector('[data-lightbox-close]')?.addEventListener('click', () => void close());

    // Click outside the image closes it.
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) void close();
    });

    // Escape: animated close, and stop it from also closing the section dialog.
    lightbox.addEventListener('cancel', (event) => {
      event.preventDefault();
      event.stopPropagation();
      void close();
    });
  }
</script>

<style>
  .project-detail {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .project {
    display: grid;
    grid-template-columns: auto minmax(0, 560px);
    align-items: center;
    justify-content: center;
    gap: clamp(32px, 5vw, 96px);
    min-height: 100%;
    padding: clamp(88px, 9vh, 120px) clamp(20px, 6vw, 120px) clamp(32px, 6vh, 64px);
  }

  .project[hidden] {
    display: none;
  }

  .project__media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .project__art {
    width: min(42vw, calc(70dvh * 265 / 242), 640px);
    transform-origin: center;
  }

  .project__art :global(.project__star) {
    width: 100%;
    filter: drop-shadow(0 12px 32px rgb(0 0 0 / 0.35));
  }

  .project__thumbs {
    display: flex;
    gap: 10px;
  }

  .project__thumb {
    width: 12px;
    height: 12px;
    padding: 0;
    border: 1.5px solid var(--color-cream);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      scale 0.2s ease;
  }

  .project__thumb[aria-pressed='true'] {
    background: var(--color-cream);
    scale: 1.2;
  }

  .project__thumb:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }

  .project__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(28px, 3vw, 48px);
    border-radius: 40px;
    background: var(--color-cream);
    color: var(--color-brown);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.3);
  }

  .project__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(32px, 3.4vw, 56px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.05;
  }

  .project__name:focus {
    outline: none;
  }

  .project__initial {
    font-family: var(--font-script);
    font-style: normal;
  }

  .project__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project__role {
    padding: 0.35em 0.9em;
    border-radius: var(--radius-pill);
    background: rgb(232 126 1 / 0.14);
    color: #b35f00;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
  }

  .project__description {
    margin: 0;
    color: #1d1006;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.05vw, 18px);
    line-height: 1.6;
  }

  .project__zoom {
    position: relative;
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: none;
    cursor: zoom-in;
  }

  .project__card-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    transition: scale 0.25s ease;
  }

  .project__zoom:hover .project__card-image {
    scale: 1.015;
  }

  .project__zoom-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-brown);
    color: var(--color-cream);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .project__zoom:hover .project__zoom-hint,
  .project__zoom:focus-visible .project__zoom-hint {
    opacity: 1;
  }

  /* Tall full-page captures: show the top part only, fading into a label. */
  .project__zoom--tall {
    height: clamp(220px, 32vh, 340px);
    overflow: hidden;
  }

  .project__zoom--tall .project__card-image {
    height: 100%;
    object-fit: cover;
    object-position: top;
    transform-origin: top;
  }

  .project__zoom--tall::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    border-radius: 0 0 16px 16px;
    background: linear-gradient(transparent, rgb(251 235 218 / 0.95));
    pointer-events: none;
  }

  .project__zoom-label {
    position: absolute;
    bottom: 16px;
    left: 50%;
    z-index: 1;
    translate: -50% 0;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-brown);
    color: var(--color-cream);
    font-family: var(--font-ui);
    font-size: 15px;
    white-space: nowrap;
  }

  /* The tall variant shows the label instead of the corner magnifier. */
  .project__zoom--tall .project__zoom-hint {
    display: none;
  }

  .project__zoom:focus-visible {
    outline: 2px solid var(--color-brown);
    outline-offset: 4px;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border: 1.5px solid var(--color-brown);
    border-radius: var(--radius-pill);
    background: var(--color-brown);
    color: var(--color-cream);
    font-family: var(--font-ui);
    font-size: 16px;
    text-decoration: none;
    transition:
      translate 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .project__link--outline {
    background: transparent;
    color: var(--color-brown);
  }

  .project__link:hover {
    translate: 0 -2px;
  }

  .project__link--outline:hover {
    background: rgb(74 37 0 / 0.08);
  }

  .project__link svg {
    flex: none;
    transition: translate 0.2s ease;
  }

  .project__link:hover svg {
    translate: 2px -2px;
  }

  .project__link:focus-visible {
    outline: 2px solid var(--color-brown);
    outline-offset: 3px;
  }

  /* --- Lightbox --- */

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 56px);
    border: 0;
    background: rgb(20 10 0 / 0.92);
    cursor: zoom-out;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: default;
  }

  /* Tall pages scroll vertically at a readable width instead of shrinking to fit. */
  .lightbox.is-tall[open] {
    display: block;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .lightbox.is-tall .lightbox__image {
    width: min(1100px, 100%);
    max-height: none;
    margin-inline: auto;
    border-radius: 12px;
  }

  .lightbox.is-tall .lightbox__close {
    position: fixed;
  }

  .lightbox__close {
    position: absolute;
    top: clamp(12px, 2.5vw, 32px);
    right: clamp(12px, 2.5vw, 32px);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--color-cream);
    color: var(--color-brown);
    cursor: pointer;
  }

  .lightbox__close:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project__card-image,
    .project__zoom-hint,
    .project__link,
    .project__link svg {
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .project {
      grid-template-columns: minmax(0, 560px);
      align-content: start;
      gap: 28px;
      padding-top: 80px;
    }

    .project__art {
      width: min(78vw, 46dvh * 265 / 242, 440px);
    }

    .project__card {
      border-radius: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project__thumb {
      transition: none;
    }
  }
</style>
